# AquaMind Environment Configuration
# Copy this file to .env and configure values

# Server Configuration
PORT=3001

# Arduino / ESP32 Serial Port
# Linux/Raspberry: /dev/ttyACM0 or /dev/ttyUSB0
# Windows: COM3 or similar
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200

# USB Camera Device
# Linux/Raspberry: /dev/video0
CAMERA_DEVICE=/dev/video0
# Camera Resolution and FPS (for feeder)
CAMERA_RESOLUTION=640x480
CAMERA_FPS=30

# Database Path
DB_PATH=./data/aquamind.db

# Gemini API Key (for AI features)
GEMINI_API_KEY=
